# dependencies
node_modules

# build output
dist
dist-ssr

# editor
.vscode/*
!.vscode/extensions.json
.idea
.claude

# logs
*.log
npm-debug.log*

# local env
*.local

# os
.DS_Store
Thumbs.db
.env
.env.local

# macOS AppleDouble shadow files - this repo lives on an external drive
# whose filesystem doesn't support native xattrs/resource forks, so macOS
# shadows them as ._<name> siblings next to nearly every file.
._*

# Local Netlify folder
.netlify

# Personal source photos used to generate recipe covers — only the
# processed output in public/recipe-previews/ needs to be in the repo.
/my-cover-photos

# Raw calibration-shoot exports fed into derive-luts-from-calibration.mjs —
# only the derived public/luts/*.png output needs to be in the repo.
/calibration-input

# iOS (Capacitor) — ios/App/App/public is a copy of dist/, regenerated by
# `npx cap copy ios` before every build, same reasoning as dist/ above.
ios/App/App/public
ios/App/build
ios/DerivedData
**/xcuserdata/
*.xcuserstate

# Phase 4 training (training/) — the code is checked in, its outputs aren't:
# model weights are regenerable from the checkpointed training run, and
# __pycache__ is Python build output, same reasoning as dist/ above.
training/checkpoints
training/__pycache__
**/__pycache__
